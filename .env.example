# Copie este archivo a ".env.local" y complete los valores.
NODE_ENV=development
PORT=3000

# Clave para firmar sesiones (mínimo 32 caracteres, aleatoria y secreta).
# Genere una con: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Neon Postgres (use la cadena de conexión pooled provista por Neon).
DATABASE_URL=

# Token de escritura para el almacén público de imágenes de Vercel Blob.
BLOB_READ_WRITE_TOKEN=

# Rutas locales opcionales para npm run migrate:vercel.
# SOURCE_DB_PATH=./data/catalogo.db
# SOURCE_UPLOAD_DIR=./uploads

# Datos del negocio
BUSINESS_NAME=Nuto Automotores
# Complete with Nuto's WhatsApp number, including country code and area code.
WHATSAPP_NUMBER=
# Official Beta Motor Argentina account; this is not Nuto's own Instagram account.
INSTAGRAM=betamotorargentina
MAP_QUERY=Av. Ameghino 1154, Esquel, Chubut 9200, Argentina

# Mensaje de WhatsApp. Variables: {producto} {categoria} {url}
WHATSAPP_MESSAGE=Hola, quiero consultar por {producto} ({categoria}) que vi en el catálogo de Nuto Automotores. {url}

# Poner en 1 si la app corre detrás de un proxy inverso (Nginx, Cloudflare, etc.)
TRUST_PROXY=0

# Recuperación de contraseña por SMTP (complete con los datos de su proveedor de correo).
# Para Gmail use una contraseña de aplicación; para producción use el dominio HTTPS público.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=
PUBLIC_BASE_URL=http://localhost:3000
# Casilla que recibe las consultas del formulario web (si se omite, se usa EMAIL_FROM).
CONTACT_EMAIL=
